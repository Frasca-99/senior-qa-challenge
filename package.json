{
  "name": "serverest-cypress",
  "version": "1.0.0",
  "description": "Suíte de testes automatizados E2E e API para o ServeRest com Cypress + Cucumber (BDD)",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "cypress run",
    "test:open": "cypress open",
    "test:api": "cypress run --expose tags=@api",
    "test:web": "cypress run --expose tags=@web",
    "test:smoke": "cypress run --expose tags=@smoke"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress": "^16.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-cypress": "^7.0.2",
    "globals": "^17.12.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.1.2"
    }
  }
}
